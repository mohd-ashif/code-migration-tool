{
  "openapi": "3.0.0",
  "info": {
    "title": "AI Code Migration Studio - Payment & SaaS Billing API",
    "version": "1.0.0",
    "description": "API documentation for AI Code Migration Studio production payment system. Powered by Razorpay (INR) with Clean Architecture Gateway Abstraction (supporting future Stripe and PayPal gateways), GST tax calculations, PDF invoice generation, refunds, subscription renewals, retries, and webhook processing."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/payments/checkout": {
      "post": {
        "summary": "Create Checkout Session",
        "description": "Initiates payment order/subscription checkout with Razorpay gateway, calculates GST taxes, and records payment events.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["planSlug", "billingCycle", "billingAddress"],
                "properties": {
                  "planSlug": { "type": "string", "example": "pro" },
                  "billingCycle": { "type": "string", "enum": ["monthly", "yearly"], "example": "monthly" },
                  "billingAddress": { "type": "object" },
                  "couponCode": { "type": "string", "example": "WELCOME100" },
                  "gatewayName": { "type": "string", "example": "razorpay" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Checkout session created successfully" }
        }
      }
    },
    "/api/payments/verify": {
      "post": {
        "summary": "Verify Payment Signature & Activate Subscription",
        "description": "Verifies checkout HMAC-SHA256 signature from Razorpay, captures payment, issues sequential GST PDF invoice, resets usage limits, and activates workspace subscription.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentId", "signature"],
                "properties": {
                  "paymentId": { "type": "string", "example": "pay_Npl7520t4wO1pZ" },
                  "signature": { "type": "string", "example": "a5d89f..." },
                  "subscriptionId": { "type": "string", "example": "sub_Npl532t5lQpXy9" },
                  "orderId": { "type": "string", "example": "order_Npl..." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment verified and subscription activated" }
        }
      }
    },
    "/api/payments": {
      "get": {
        "summary": "List Payment History with Search, Filter & Pagination",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["captured", "failed", "refunded", "authorized", "all"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Payment history retrieved successfully" }
        }
      }
    },
    "/api/payments/{id}": {
      "get": {
        "summary": "Get Payment Detail by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Payment details retrieved" }
        }
      }
    },
    "/api/payments/{id}/refund": {
      "post": {
        "summary": "Refund Payment",
        "description": "Calls Razorpay refund API, records refund entry, logs audit events, and updates payment/invoice status.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "number", "example": 999.00 },
                  "reason": { "type": "string", "example": "Customer requested refund" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Refund processed" }
        }
      }
    },
    "/api/payments/{id}/retry": {
      "post": {
        "summary": "Retry Failed Payment",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Retry payment session created" }
        }
      }
    },
    "/api/invoices": {
      "get": {
        "summary": "List Workspace Invoices",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of GST invoices" }
        }
      }
    },
    "/api/invoices/{id}": {
      "get": {
        "summary": "Get Invoice Details",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Invoice details" }
        }
      }
    },
    "/api/invoices/{id}/download": {
      "get": {
        "summary": "Download PDF Invoice",
        "description": "Streams generated GST PDF invoice with company logo, GSTIN, workspace details, CGST/SGST/IGST breakdown.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "PDF stream response", "content": { "application/pdf": {} } }
        }
      }
    },
    "/api/subscription/renew": {
      "post": {
        "summary": "Renew Subscription (Manual / Auto)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Subscription renewed" }
        }
      }
    },
    "/api/subscription/cancel": {
      "post": {
        "summary": "Cancel Active Subscription",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Subscription scheduled for cancellation" }
        }
      }
    },
    "/api/subscription/resume": {
      "post": {
        "summary": "Resume Cancelled Subscription",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Subscription resumed" }
        }
      }
    },
    "/api/webhooks/razorpay": {
      "post": {
        "summary": "Razorpay Webhooks Listener",
        "description": "Processes payment.authorized, payment.captured, payment.failed, refund.processed, subscription.activated, subscription.cancelled, subscription.charged, subscription.paused, subscription.resumed, invoice.paid, invoice.expired with 100% idempotency.",
        "parameters": [
          { "name": "x-razorpay-signature", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Webhook event processed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
